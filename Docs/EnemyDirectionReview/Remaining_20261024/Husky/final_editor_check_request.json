{
  "actions": [
    {
      "method": "resource",
      "uri": "mcpforunity://editor/state"
    },
    {
      "method": "tool",
      "name": "read_console",
      "arguments": {
        "action": "get",
        "types": [
          "error"
        ],
        "count": "50",
        "format": "json"
      }
    },
    {
      "method": "tool",
      "name": "execute_code",
      "arguments": {
        "action": "execute",
        "code": "return new {compileFailed=UnityEditor.EditorUtility.scriptCompilationFailed,playing=UnityEditor.EditorApplication.isPlayingOrWillChangePlaymode,compiling=UnityEditor.EditorApplication.isCompiling,updating=UnityEditor.EditorApplication.isUpdating,review=FTProject.EditorTools.EnemyDirectionBatchReview.Running,recording=FTProject.EditorTools.BalanceVideoRecorder.Running,dirty=UnityEngine.SceneManagement.SceneManager.GetActiveScene().isDirty,scene=UnityEngine.SceneManagement.SceneManager.GetActiveScene().path};"
      }
    }
  ]
}
