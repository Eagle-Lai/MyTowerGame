+                var receiver=clone.GetComponent<MonsterAnimEventReceiver>();var head=receiver.HeadRenderer;var heads=receiver.HeadSprites;
+                for(int repeat=0;repeat<2;repeat++)
+                {
+                    bool applied=EnemyDirectionPrefabBuilder.ApplyIfConfigured(clone,spec.ArtDir.Substring(0,spec.ArtDir.Length-"/Directions".Length)+"/"+spec.Name+".png");
