# ============================================================================
#  Unity 工程 .gitignore  —  FreeTower
# ----------------------------------------------------------------------------
#  设计原则：
#    1. Unity 自动重建的目录一律忽略（Library / Temp / obj / Logs / UserSettings）
#    2. 构建产物与大体积二进制一律忽略（apk / aab / 打包输出目录）
#    3. 用于生成工程文件的中间产物忽略（*.csproj / *.sln，Unity 会重新生成）
#    4. 必须提交的内容绝不忽略：Assets 资产、Packages/manifest.json、
#       ProjectSettings、以及 Assets/StreamingAssets/json/ 下的 Luban 配置数据
#
#  ⚠️ 注意：本文件曾存在一条 `*.json` 规则，会导致 Luban 导出的配置表
#     （Assets/StreamingAssets/json/*.json）永远无法提交，已移除。
#     如需新增忽略规则，请勿使用宽泛的 `*.json` / `*.asset` 通配符。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Unity 自动生成的缓存与中间目录（可通过重新打开工程重建）
# ---------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/*
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Ee]xportedObj/

# Unity 崩溃与调试输出
sysinfo.txt
crashlytics-build.properties
*BurstDebugInformation_DoNotShip/

# ---------------------------------------------------------------------------
# 2. 本工程专属：构建产物与大体积二进制
# ---------------------------------------------------------------------------
/ttttt/
*.apk
*.aab
*.ipa
*.unitypackage

# ---------------------------------------------------------------------------
# 例外：共享 APK 入库（家用D 出包后提交，公司E 直接 pull，各机不再各自出包）
# Builds/Android 下其余内容一律忽略，仅放行 freedomtower.apk。
# 规则按"最后匹配者胜"，故顺序必须是：反忽略目录 → 忽略目录内容 → 反忽略该文件。
# ---------------------------------------------------------------------------
!Builds/Android/
[Bb]uilds/Android/*
!Builds/Android/freedomtower.apk

# 构建时生成的标记文件（每次打包都会变化）
/Assets/StreamingAssets/build_info

# ---------------------------------------------------------------------------
# 2b. 派生资源：由工具从源头重新生成，不入库（避免与源头分叉）
# ---------------------------------------------------------------------------
# AssetBundle 构建产物（每个平台一份，可重新打包）
/Assets/StreamingAssets/AssetBundles/

# YooAsset 构建产物目录（由「Tools ▸ 塔防 ▸ YooAsset 接入」向导生成，可重新构建）
/Assets/StreamingAssets/yoo/

# 独立 AB 打包输出目录（工程根目录，随构建重新生成）
/Bundles/

# 本机热更资源服务器根目录（把 Bundles/<平台>/<包裹>/<版本>/ 与
# StreamingAssets/HybridCLR/*.dll 拷进来，用 Python http.server 提供给真机）。
# 内容全部可从上面两处重新拷贝，属派生物；用 Tools/sync_to_server.sh 一键同步。
/ServerRoot/

# 公司E 本机热更资源服务器（junction：Android/HybridCLR→StreamingAssets/HybridCLR，
# Android/FreeTower→Bundles/Android/FreeTower），同样只服务本机 python http.server。
# 内容与上面两处构成重复，且 junction 在异机不可用，不入库。
/HotUpdateServer/

# 注意：Assets/ConfigJson/ 是 Luban 的输出目录，属于**源数据**，必须入库！
# （它不在忽略列表里。历史上曾把它当"派生副本"忽略并放在 StreamingAssets/json，
#   但 StreamingAssets 下的文件不会导入成 TextAsset，编辑器读不到内容，已改正。）

# ---------------------------------------------------------------------------
# 3. HybridCLR（本机安装生成，体积约 800MB，可重新安装）
# ---------------------------------------------------------------------------
/HybridCLRData/

# ---------------------------------------------------------------------------
# 4. Luban 配置表工具链的生成缓存与临时文件
# ---------------------------------------------------------------------------
# Luban 的增量导出缓存（含本机绝对路径，跨机器无效）
/Luban/.cache.meta
# 历史遗留：早期导出路径写错（应为 Assets 却生成了 ..Assets）产生的过期副本
/Luban/..Assets/
# Excel 打开时产生的 Office 锁文件
Luban/Config/Datas/~$*.xlsx
~$*.xlsx

# ---------------------------------------------------------------------------
# 4b. AI 协作工作区的自动备份快照（M2 起新增）
# ---------------------------------------------------------------------------
# .workbuddy/tools/apply_m2_*.py 等脚本在改配置表前会整份快照到 .workbuddy/backup/<时间戳>/。
# 设计原则第 2 条同理：这是**可丢弃的中间产物**，每跑一次脚本就多一份，
# 入库只会让仓库随改动次数线性膨胀。需要历史版本时用 git 即可。
# 注意：只忽略 backup/，.workbuddy/tools/ 与 .workbuddy/memory/ 必须入库。
/.workbuddy/backup/
/.workbuddy/backups/

# ---------------------------------------------------------------------------
# 4b-2. 一次性临时产物（效果图渲染用的 Chrome 配置 / 中间 HTML / PNG 草稿）
# ---------------------------------------------------------------------------
# 校验效果图排版时会把 SVG 包成 HTML 用 headless Chrome 截图核对，
# 会生成数十 MB 的浏览器 profile 与临时 png。纯中间产物，随时可重建。
/.workbuddy/tmp/
# 会话级临时文件（如 tmp_sid.txt：记录当前会话 id），随用随弃
/.workbuddy/tmp_*

# Python 工具脚本的运行缓存（由解释器自动生成，可丢弃）
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# 4c. 地图编辑器的页面导出中转文件（M3-7）
# ---------------------------------------------------------------------------
# 编辑器「一键写入 xlsx」会先把页面上的棋盘写成 .workbuddy/levelmap_export.json，
# 再由 Python 脚本读它写回 LevelMap.xlsx —— 每次点击都会被整体覆盖。
# 它随时是"上一个正在编辑的半成品"，入库没有意义，更容易被误当成权威数据。
/.workbuddy/levelmap_export.json

# ---------------------------------------------------------------------------
# 5. IDE / 编辑器生成的工程文件（Unity 会自动重新生成）
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# ---------------------------------------------------------------------------
# 6. 操作系统杂项
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# 7. P1 工程卫生：退役归档区（移出主干但不物理删除，保留可回溯）
# ---------------------------------------------------------------------------
# 存放 Luban 示例遗留（Csharp_CustomTemplate_AsyncLoad / GenerateDatas / Luban_Config_Gen）
# 与历史打包 demo（tips.zip / tips.apk / ttttt_buildplayer）。均不参与 Unity 编译。
# 需要时从 git 历史按原路径取回；平时不入库以免仓库随改动膨胀。
/.deprecated/

# 历史遗留的 38MB 打包 demo 压缩包（已移入 .deprecated/）
/tips.zip
/tips.apk

# 怪物换皮原始图快照（一次性备份，不入库）
/.workbuddy/reskin_backup/

# ---------------------------------------------------------------------------
# 5. 配置表拆分的一次性回滚备份（2026-10-21 v7 按关拆表）
#    Versions/<stamp>/Datas 是迁移前的整份 xlsx 备份，可由
#    .workbuddy/tools/migrate_split_level_tables.py 重新生成，体积 ~8MB，
#    只作本机回滚用，不入库（Versions 下的 *.json 仍照常提交）。
# ---------------------------------------------------------------------------
Luban/BalanceDesign/Versions/*/Datas/

# ---------------------------------------------------------------------------
# 6. 关卡回放录像（2026-10-23 新增，BalanceVideoRecorder 产出）
#    单关 720p 约 100–500MB，30 关可达十几 GB，只作本机验收素材，不入库。
#    需要归档时单独打包外传，不要提交。
# ---------------------------------------------------------------------------
/Docs/LevelVideos/

# ---------------------------------------------------------------------------
# 8. 平衡验收与四方向审阅的过程证据（2026-10-23 新增）
#    raw-trials（约 1.5GB）、audit（约 257MB）、逐关 evidence 截图、审阅帧
#    runtime_*（含 tailfix/polish 等各轮）、生成原图、首次成功试跑等属可重算的
#    中间过程，体积 GB 级，只留本机。
#    结论级文件（每关「完整逐波操作与测试报告.md」「最终布阵图.png」
#    「trial-index.*」「reproducibility.json」、各怪物 offline_/parts_ 审阅图、
#    README 与清单 json）仍照常入库。
# ---------------------------------------------------------------------------
/Docs/BalanceEvidence/L02-L30-ManualBalance-100Gold/raw-trials/
/Docs/BalanceEvidence/L02-L30-ManualBalance-100Gold/audit/
/Docs/BalanceEvidence/L02-L30-ManualBalance-100Gold/L01-current-check/
/Docs/BalanceEvidence/L02-L30-ManualBalance-100Gold/*/evidence/
/Docs/BalanceEvidence/L02-L30-ManualBalance-100Gold/*/search-*/
/Docs/BalanceEvidence/L02-L30-ManualBalance-100Gold/*/current-version-seed/
/Docs/BalanceEvidence/L02-L30-ManualBalance-100Gold/*/final-player-plans/
/Docs/BalanceEvidence/L02-L30-ManualBalance-100Gold/*/首次成功-r*/
/Docs/BalanceEvidence/L02-L30-ManualBalance-100Gold/*/best-result.json
/Docs/EnemyDirectionReview/AdvancedHen/frames/
/Docs/EnemyDirectionReview/AdvancedHen/history/
/Docs/EnemyDirectionReview/AdvancedHen/revision_02/
/Docs/EnemyDirectionReview/AdvancedHen/revision_03/
/Docs/EnemyDirectionReview/Batch01_10/*/generation/
/Docs/EnemyDirectionReview/Batch01_10/*/runtime_*/
/Docs/EnemyDirectionReview/Batch01_10/*/staged_art/

# ---------------------------------------------------------------------------
# 9. Unity 缓存目录（2026-10-23 补，此前遗漏导致 Library/BalanceWorkbench
#    的 281 个工作台运行结果被误提交）
#    Library 全部由编辑器重建，不入库；需要保留的运行结论请写到 Docs/。
# ---------------------------------------------------------------------------
/Library/
/Temp/
/Obj/
/Logs/

# Original audio delivery ZIP is reproducible from the adjacent source files.
# Keep it local: the archive exceeds GitHub's 100 MiB per-file limit.
/AudioProduction/OriginalPack_20261023/FreedomTower_Watchlight_OriginalPack_20261023.zip

