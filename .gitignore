# ============================================================================
#  Unity 工程 .gitignore  —  FreeTower
# ----------------------------------------------------------------------------
#  设计原则：
#    1. Unity 自动重建的目录一律忽略（Library / Temp / obj / Logs / UserSettings）
#    2. 构建产物与大体积二进制一律忽略（apk / aab / 打包输出目录）
#    3. 用于生成工程文件的中间产物忽略（*.csproj / *.sln，Unity 会重新生成）
#    4. 必须提交的内容绝不忽略：Assets 资产、Packages/manifest.json、
#       ProjectSettings、以及 Assets/StreamingAssets/json/ 下的 Luban 配置数据
#
#  ⚠️ 注意：本文件曾存在一条 `*.json` 规则，会导致 Luban 导出的配置表
#     （Assets/StreamingAssets/json/*.json）永远无法提交，已移除。
#     如需新增忽略规则，请勿使用宽泛的 `*.json` / `*.asset` 通配符。
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Unity 自动生成的缓存与中间目录（可通过重新打开工程重建）
# ---------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Ee]xportedObj/

# Unity 崩溃与调试输出
sysinfo.txt
crashlytics-build.properties
*BurstDebugInformation_DoNotShip/

# ---------------------------------------------------------------------------
# 2. 本工程专属：构建产物与大体积二进制
# ---------------------------------------------------------------------------
/ttttt/
*.apk
*.aab
*.ipa
*.unitypackage

# 构建时生成的标记文件（每次打包都会变化）
/Assets/StreamingAssets/build_info

# ---------------------------------------------------------------------------
# 2b. 派生资源：由工具从源头重新生成，不入库（避免与源头分叉）
# ---------------------------------------------------------------------------
# AssetBundle 构建产物（每个平台一份，可重新打包）
/Assets/StreamingAssets/AssetBundles/

# 注意：Assets/ConfigJson/ 是 Luban 的输出目录，属于**源数据**，必须入库！
# （它不在忽略列表里。历史上曾把它当"派生副本"忽略并放在 StreamingAssets/json，
#   但 StreamingAssets 下的文件不会导入成 TextAsset，编辑器读不到内容，已改正。）

# ---------------------------------------------------------------------------
# 3. HybridCLR（本机安装生成，体积约 800MB，可重新安装）
# ---------------------------------------------------------------------------
/HybridCLRData/

# ---------------------------------------------------------------------------
# 4. Luban 配置表工具链的生成缓存与临时文件
# ---------------------------------------------------------------------------
# Luban 的增量导出缓存（含本机绝对路径，跨机器无效）
/Luban/.cache.meta
# 历史遗留：早期导出路径写错（应为 Assets 却生成了 ..Assets）产生的过期副本
/Luban/..Assets/
# Excel 打开时产生的 Office 锁文件
Luban/Config/Datas/~$*.xlsx
~$*.xlsx

# ---------------------------------------------------------------------------
# 4b. AI 协作工作区的自动备份快照（M2 起新增）
# ---------------------------------------------------------------------------
# .workbuddy/tools/apply_m2_*.py 等脚本在改配置表前会整份快照到 .workbuddy/backup/<时间戳>/。
# 设计原则第 2 条同理：这是**可丢弃的中间产物**，每跑一次脚本就多一份，
# 入库只会让仓库随改动次数线性膨胀。需要历史版本时用 git 即可。
# 注意：只忽略 backup/，.workbuddy/tools/ 与 .workbuddy/memory/ 必须入库。
/.workbuddy/backup/

# ---------------------------------------------------------------------------
# 5. IDE / 编辑器生成的工程文件（Unity 会自动重新生成）
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# ---------------------------------------------------------------------------
# 6. 操作系统杂项
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
